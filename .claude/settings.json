{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(nano *.env*)",
      "Bash(vim *.env*)",
      "Bash(vi *.env*)",
      "Bash(xxd *.env*)",
      "Bash(od *.env*)",
      "Bash(strings *.env*)",
      "Bash(hexdump *.env*)",
      "Bash(grep *.env*)",
      "Bash(awk *.env*)",
      "Bash(sed *.env*)",
      "Bash(perl *.env*)",
      "Bash(python *.env*)",
      "Bash(ruby *.env*)",
      "Bash(type *.env*)",
      "Bash(find *.env*)",
      "Bash(cp *.env*)",
      "Bash(mv *.env*)",
      "Bash(rm *.env*)",
      "Bash(tar *.env*)",
      "Bash(zip *.env*)",
      "Read(.local/.playwright-secrets)",
      "Read(**/.playwright-secrets)",
      "Bash(cat *playwright-secrets*)",
      "Bash(less *playwright-secrets*)",
      "Bash(more *playwright-secrets*)",
      "Bash(head *playwright-secrets*)",
      "Bash(tail *playwright-secrets*)",
      "Bash(nano *playwright-secrets*)",
      "Bash(vim *playwright-secrets*)",
      "Bash(vi *playwright-secrets*)",
      "Bash(xxd *playwright-secrets*)",
      "Bash(od *playwright-secrets*)",
      "Bash(strings *playwright-secrets*)",
      "Bash(hexdump *playwright-secrets*)",
      "Bash(grep *playwright-secrets*)",
      "Bash(awk *playwright-secrets*)",
      "Bash(sed *playwright-secrets*)",
      "Bash(perl *playwright-secrets*)",
      "Bash(python *playwright-secrets*)",
      "Bash(ruby *playwright-secrets*)",
      "Bash(type *playwright-secrets*)",
      "Bash(find *playwright-secrets*)",
      "Bash(cp *playwright-secrets*)",
      "Bash(mv *playwright-secrets*)",
      "Bash(rm *playwright-secrets*)",
      "Bash(tar *playwright-secrets*)",
      "Bash(zip *playwright-secrets*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v powershell >/dev/null 2>&1; then powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/deny-env-reads.ps1\"; fi",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "if command -v jq >/dev/null 2>&1; then sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/deny-env-reads.sh\"; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
